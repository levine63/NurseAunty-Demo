# NurseAunty public demo: static MIME types.
#
# Generated by tools/build-public-demo.mjs from the file types this package actually contains.
# Do not hand-edit; it is overwritten on every publish.
#
# Why it exists: a host that has no MIME type for an extension may answer 404 for it, so every
# .webp image in this package was unreachable even though the files were present and byte-identical.
# Apache honours this only where AllowOverride permits it; elsewhere the file is inert.
AddType text/css .css
AddType text/html .html
AddType text/javascript .js
AddType application/json .json
AddType audio/mp4 .m4a
AddType audio/mpeg .mp3
AddType audio/ogg .ogg
AddType image/png .png
AddType image/svg+xml .svg
AddType text/plain .txt
AddType image/webp .webp
