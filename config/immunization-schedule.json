  "openQuestions": [
    {
      "id": "schedule-source",
      "question": "Which schedule should a deployment ship by default? These days follow a common WHO-style pattern, but national EPI schedules differ, and the app should not propose a date a local clinic would not recognise. Options are to ship no default and require a deployment to supply one, or to keep a labelled prototype default as now.",
      "decidedBy": "David Levine with clinical and local EPI review",
